<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>143d6e34-3846-4ad5-b3b3-aa01cd223b56</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parLoc">
            <Value>=Parameters!parLoc.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parCompany">
            <Value>=Parameters!parCompany.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parCategory">
            <Value>=Parameters!parCategory.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Company, Location, Plan_Update, Category, Asset_Name, asset_tag, PurYears, Model_No, HDD1, RAM1, CPU, Model, HDD2, RAM2, UserName, Department, Status, ConfigNo, notes, Purchase AS Purchased, SuppliersName, 
                  UpgradeReason
FROM     v_ComPlanToUpgrade
WHERE  (Location IN (@parLoc)) AND (Company IN (@parCompany)) AND (Category IN (@parCategory))
ORDER BY Location, Company</CommandText>
      </Query>
      <Fields>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Plan_Update">
          <DataField>Plan_Update</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Asset_Name">
          <DataField>Asset_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Asset_Tag">
          <DataField>asset_tag</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PurYears">
          <DataField>PurYears</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Username">
          <DataField>UserName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Model">
          <DataField>Model</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Model_No">
          <DataField>Model_No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CPU">
          <DataField>CPU</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="HDD1">
          <DataField>HDD1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RAM1">
          <DataField>RAM1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="HDD2">
          <DataField>HDD2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RAM2">
          <DataField>RAM2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Department">
          <DataField>Department</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ConfigNo">
          <DataField>ConfigNo</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="Notes">
          <DataField>notes</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Purchased">
          <DataField>Purchased</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="SuppliersName">
          <DataField>SuppliersName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UpgradeReason">
          <DataField>UpgradeReason</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLoc">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        Location
FROM            v_Location</CommandText>
      </Query>
      <Fields>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datCategory">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        Category
FROM            v_Category</CommandText>
      </Query>
      <Fields>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datCompany">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        Company AS CompName, CompanyCode AS CompCode
FROM            v_Company
ORDER BY CompCode</CommandText>
      </Query>
      <Fields>
        <Field Name="CompName">
          <DataField>CompName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CompCode">
          <DataField>CompCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
