<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6fcbeff6-9cdf-43f3-8ec9-2925b6e420e8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parLicensName">
            <Value>=Parameters!parLicensName.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parCompany">
            <Value>=Parameters!parCompany.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        LicenseName, serial, purchase_order, purchase_date, expiration_date, license_email, purchase_cost, order_number, notes, license_name, seats, ManuName, name
FROM            v_License_Sum
WHERE        (LicenseName LIKE @parLicensName + N'%') AND (name IN (@parCompany))
ORDER BY LicenseName</CommandText>
      </Query>
      <Fields>
        <Field Name="LicenseName">
          <DataField>LicenseName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="serial">
          <DataField>serial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="purchase_order">
          <DataField>purchase_order</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="purchase_date">
          <DataField>purchase_date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="expiration_date">
          <DataField>expiration_date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="license_email">
          <DataField>license_email</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="purchase_cost">
          <DataField>purchase_cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="order_number">
          <DataField>order_number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="notes">
          <DataField>notes</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="seats">
          <DataField>seats</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="license_name">
          <DataField>license_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ManuName">
          <DataField>ManuName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="name">
          <DataField>name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLicense">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        LicenseName
FROM            v_ConfigLicenseWindows
ORDER BY LocSort</CommandText>
      </Query>
      <Fields>
        <Field Name="LicenseName">
          <DataField>LicenseName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datCompany">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT Company AS ComVal, Company AS ComLab, ConfigInt1 AS ComSort
FROM     v_Company</CommandText>
      </Query>
      <Fields>
        <Field Name="ComVal">
          <DataField>ComVal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComLab">
          <DataField>ComLab</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComSort">
          <DataField>ComSort</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
