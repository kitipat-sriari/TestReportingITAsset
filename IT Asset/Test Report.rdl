  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT ConfigID, ConfigNo
FROM     Config
GROUP BY ConfigID, ConfigNo
HAVING (ConfigID = 1)</CommandText>
      </Query>
      <Fields>
        <Field Name="ConfigID">
          <DataField>ConfigID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ConfigNo">
          <DataField>ConfigNo</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
