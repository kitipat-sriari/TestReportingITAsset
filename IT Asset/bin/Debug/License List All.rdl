      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT License_ID, LicenseName, LicenseSeats, serial, purchase_order, purchase_date, expiration_date, license_email, purchase_cost, order_number, notes, AssetsName, license_name, UserFirstName, UserEmail
FROM     v_License</CommandText>
