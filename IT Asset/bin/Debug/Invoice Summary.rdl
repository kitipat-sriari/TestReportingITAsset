  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datERP85Test</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parDate1">
            <Value>=Parameters!parDate1.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parDate2">
            <Value>=Parameters!parDate2.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parCustID">
            <Value>=Parameters!parCustID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parProdFam">
            <Value>=Parameters!parProdFam.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parItemClass">
            <Value>=Parameters!parItemClass.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parSaleType">
            <Value>=Parameters!parSaleType.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parItemStlye">
            <Value>=Parameters!parItemStlye.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parSOID">
            <Value>=Parameters!parSOID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parSaleTeritery">
            <Value>=Parameters!parSaleTeritery.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parEMPID">
            <Value>=Parameters!parEMPID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT 
                         Invoice.IVM_InvoiceID AS InvID, Invoice.IVM_InvoiceDate AS InvDate, Invoice.IVM_InvoiceAmt AS InvAmt, Invoice.IVM_InvoiceType AS InvType, 
                         Invoice.IVM_CurrencyType AS InvCurrencyType, Invoice.IVM_CurrencyRate AS InvCurrencyRate, Invoice.IVM_UserDef1 AS PI, Customer.CUS_CustomerID AS CustID, 
                         Customer.CUS_CorpName + N' ' + COALESCE (Customer.CUS_ConsolidCustomerID, N'') AS CustName, SalesOrder.SOM_CustomerPOID AS CustPO, 
                         SalesOrder.SOM_SalesOrderID AS SOID, SalesOrderLine.SOI_SOLineNbr AS SOLine, SalesOrderDelivery.SOD_RequiredDate AS SOReqDate, 
                         SalesOrderDelivery.SOD_RequiredQty AS SOReqQty, SalesOrderDelivery.SOD_UnitPrice AS SOPrice, ShipmentLine.SHL_ShipQty AS ShipQty, 
                         Item.IMA_ItemID AS ItemID, Item.IMA_ItemName AS ItemName, Item.IMA_UnitMeasure AS ItemUnits, COALESCE (Item.IMA_ProdFam, N'') AS ItemGroup, 
                         COALESCE (Item.IMA_Classification, N'') AS ItemClass, COALESCE (SalesOrder.SOM_Buyer, N'') AS SOBuyer, COALESCE (SalesOrder.SOM_DefaultShipMethod, N'') 
                         AS SOShipmethod, Shipment.SH_ShipDate, VTA_ProformaRevNo1.PF_ProformaID, VTA_ProformaRevNo1.PF_ProformaDate, VTA_ProformaRevNo1.PF_ETA, 
                         VTA_ProformaRevNo1.PF_ETD, VTA_ProformaRevNo1.PF_LOADDate, COALESCE (VTA_ProformaRevNo1.SaleType, '') AS SaletypeNew, 
                         COALESCE (Item.IMA_CommodityCode, N'') AS ItemStlye, CONVERT(nvarchar(100), SalesOrder.SOM_SpecialInst) AS SOSpecInst, 
                         CustomerShipTo.CSA_Name AS ShipToName, ItemAttribute.Attribute17_Value AS ItemColor, Customer.CUS_CorpCountry AS CustCountry, 
                         CustomerShipTo.CSA_Country AS ShipToCountry, Invoice.IVM_ReversedFlag, ProjectGroup.PRJG_ProjectID, ProjectGroup.PRJG_Description, DATEPART(Month, 
                         Invoice.IVM_InvoiceDate) AS InvMonth, DATEPART(Year, Invoice.IVM_InvoiceDate) AS InvYear, SalesOrderDelivery.SOD_CommitDate, 
                         SalesOrder.SOM_DefaultTerritoryCodes, EMP.EMP_EmployeeID, CASE WHEN (SOI_SalesConvUnitMeasure NOT LIKE 'Meter%') AND 
                         (SOI_SalesConvUnitMeasure NOT LIKE 'Yard%') 
                         THEN 0 ELSE CASE WHEN SOI_SalesConvUnitMeasure LIKE 'Meter%' THEN SHL_ShipQty / 0.9144 ELSE SHL_ShipQty END END AS ShipYard, 
                         Customer.CUS_ConsolidCustomerID, VTA_ProformaRevNo1.PF_ShipTerm
FROM            SalesOrderDelivery INNER JOIN
                         SalesOrderLine ON SalesOrderDelivery.SOD_SOI_RecordID = SalesOrderLine.SOI_RecordID INNER JOIN
                         ShipmentLine INNER JOIN
                         Shipment ON ShipmentLine.SHL_SH_RecordID = Shipment.SH_RecordID INNER JOIN
                         Invoice INNER JOIN
                         InvoiceLine ON Invoice.IVM_RecordID = InvoiceLine.IVL_IVM_RecordID INNER JOIN
                         SalesOrder ON Invoice.IVM_SOM_RecordID = SalesOrder.SOM_RecordID ON ShipmentLine.SHL_RecordID = InvoiceLine.IVL_SHL_RecordID ON 
                         SalesOrderDelivery.SOD_RecordID = ShipmentLine.SHL_SOD_RecordID AND SalesOrderLine.SOI_SOM_RecordID = SalesOrder.SOM_RecordID INNER JOIN
                         Item ON SalesOrderLine.SOI_IMA_RecordID = Item.IMA_RecordID INNER JOIN
                         Customer ON SalesOrder.SOM_CUS_RecordID = Customer.CUS_RecordID INNER JOIN
                         ItemAttribute ON Item.IMA_RecordID = ItemAttribute.ItemAttr_IMA_RecordID INNER JOIN
                         EMP ON SalesOrder.SOM_EMP_RecordID = EMP.EMP_RecordID LEFT OUTER JOIN
                         ProjectGroup ON SalesOrderLine.SOI_DefaultPRJG_RecordID = ProjectGroup.PRJG_RecordID LEFT OUTER JOIN
                         CustomerShipTo ON SalesOrderLine.SOI_DefaultCSA_RecordID = CustomerShipTo.CSA_RecordID LEFT OUTER JOIN
                         VTA_ProformaRevNo1 ON SalesOrder.SOM_RecordID = VTA_ProformaRevNo1.PF_SOM_RecordID
WHERE        (Invoice.IVM_InvoiceDate &gt;= @parDate1) AND (Invoice.IVM_InvoiceDate &lt; @parDate2 + 1) AND (Customer.CUS_CustomerID LIKE CASE WHEN @parCustID = NULL OR
                         Len(@parCustID) = 0 THEN '%' ELSE @parCustID END) AND (COALESCE (Item.IMA_CommodityCode, N'') LIKE @parItemStlye) AND (COALESCE (Item.IMA_ProdFam, 
                         N'') LIKE @parProdFam) AND (COALESCE (Item.IMA_Classification, N'') LIKE @parItemClass) AND 
                         (SalesOrder.SOM_SalesOrderID LIKE CASE WHEN @parSOID = NULL OR
                         Len(@parSOID) = 0 THEN '%' ELSE @parSOID END) AND (Invoice.IVM_ReversedFlag = 0) AND (COALESCE (VTA_ProformaRevNo1.SaleType, N'') LIKE @parSaleType)
                          AND (SalesOrder.SOM_DefaultTerritoryCodes LIKE @parSaleTeritery) AND (EMP.EMP_EmployeeID LIKE CASE WHEN @parEMPID = NULL OR
                         Len(@parEMPID) = 0 THEN '%' ELSE @parEMPID END)
ORDER BY InvID</CommandText>
      </Query>
