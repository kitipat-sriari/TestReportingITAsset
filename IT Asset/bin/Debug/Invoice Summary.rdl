    <DataSet Name="datTerritory">
      <Query>
        <DataSourceName>datERP85Test</DataSourceName>
        <CommandText>SELECT        '%' AS SaleTerritoryVal, '---All---' AS SaleTerritoryLabel, '01' AS SaleTerritorySort
UNION
SELECT        'Local' AS SaleTerritoryVal, 'Local' AS SaleTerritoryLabel, '02' AS SaleTerritorySort
UNION
SELECT        'Export' AS SaleTerritoryVal, 'Export' AS SaleTerritoryLabel, '03' AS SaleTerritorySort
ORDER BY SaleTerritorySort</CommandText>
      </Query>
