<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>0c1c8740-b861-4f28-88fb-e49b39a8d2db</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parLicenseName">
            <Value>=Parameters!parLicenseName.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parCompany">
            <Value>=Parameters!parCompany.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Company, License_Name, Seats, Product_Key, Expiration_Date, Remaining_Seats, Purchase_Date, Purchase_Cost, Depreciation, Current_Value
FROM            License_Report
WHERE        (License_Name LIKE N'%' + @parLicenseName + N'%') AND (Company IN (@parCompany))
ORDER BY Company, License_Name</CommandText>
      </Query>
      <Fields>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="License_Name">
          <DataField>License_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Seats">
          <DataField>Seats</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="Product_Key">
          <DataField>Product_Key</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Expiration_Date">
          <DataField>Expiration_Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Remaining_Seats">
          <DataField>Remaining_Seats</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="Purchase_Date">
          <DataField>Purchase_Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Purchase_Cost">
          <DataField>Purchase_Cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Depreciation">
          <DataField>Depreciation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Current_Value">
          <DataField>Current_Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datCompany">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        Company
FROM            v_LicenseCompany</CommandText>
      </Query>
      <Fields>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
