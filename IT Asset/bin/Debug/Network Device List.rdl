<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>15a8066b-860b-4d95-850b-42ae12863ff3</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parAssetName">
            <Value>=Parameters!parAssetName.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parModel">
            <Value>=Parameters!parModel.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parCategory">
            <Value>=Parameters!parCategory.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parStatus">
            <Value>=Parameters!parStatus.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parLoc">
            <Value>=Parameters!parLoc.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Location, Company, Category, PurYears, Asset_Name, asset_tag, Model_No, Purchased, Department, Status, SuppliersName, CategoryGroup, CategoryName, notes
FROM     v_NetworkDevice
WHERE  (Asset_Name LIKE CASE WHEN Len(@parAssetName) = 0 THEN '%' ELSE '%' + @parAssetName + '%' END) AND (Model_No LIKE CASE WHEN Len(@parModel) = 0 THEN '%' ELSE '%' + @parModel + '%' END) AND 
                  (Category IN (@parCategory)) AND (Status IN (@parStatus)) AND (Location IN (@parLoc))</CommandText>
      </Query>
      <Fields>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PurYears">
          <DataField>PurYears</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Asset_Name">
          <DataField>Asset_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="asset_tag">
          <DataField>asset_tag</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Model_No">
          <DataField>Model_No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Purchased">
          <DataField>Purchased</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Department">
          <DataField>Department</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SuppliersName">
          <DataField>SuppliersName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CategoryGroup">
          <DataField>CategoryGroup</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CategoryName">
          <DataField>CategoryName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="notes">
          <DataField>notes</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datCategory">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT CategoryName
FROM     v_Category03Network</CommandText>
      </Query>
      <Fields>
