          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MACAddress">
          <DataField>MACAddress</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InternalIPAddress">
          <DataField>InternalIPAddress</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastPublicIP">
          <DataField>LastPublicIP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WindowsFullOS">
          <DataField>WindowsFullOS</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CalDate">
          <DataField>CalDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLoc">
      <Query>
