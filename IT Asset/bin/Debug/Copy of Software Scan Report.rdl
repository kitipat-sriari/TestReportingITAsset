<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>9d1a887d-d14d-4553-8b78-a5ce86fad504</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parComName">
            <Value>=Parameters!parComName.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parBeUnder">
            <Value>=Parameters!parBeUnder.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parSoftwareName">
            <Value>=Parameters!parSoftwareName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT CompanyName, ComName, SoftwareName, InstalledDate, Version, ScanDate, CalDate, SoftwareTyep, CheckDate
FROM     v_SWScanDetail
WHERE  (CompanyName IN (@parBeUnder)) AND (ComName LIKE CASE WHEN Len(@parComName) = 0 THEN '%' ELSE '%' + @parComName + '%' END) AND (SoftwareName LIKE CASE WHEN Len(@parSoftwareName) 
                  = 0 THEN '%' ELSE '%' + @parSoftwareName + '%' END)</CommandText>
      </Query>
      <Fields>
        <Field Name="CompanyName">
          <DataField>CompanyName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComName">
          <DataField>ComName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SoftwareName">
          <DataField>SoftwareName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InstalledDate">
          <DataField>InstalledDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Version">
          <DataField>Version</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CalDate">
          <DataField>CalDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="ScanDate">
          <DataField>ScanDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="SoftwareTyep">
          <DataField>SoftwareTyep</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CheckDate">
          <DataField>CheckDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datBeUnder">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT CompanyName AS BeUnder
FROM     v_SWScanDetail
GROUP BY CompanyName
ORDER BY BeUnder</CommandText>
      </Query>
      <Fields>
        <Field Name="BeUnder">
          <DataField>BeUnder</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
