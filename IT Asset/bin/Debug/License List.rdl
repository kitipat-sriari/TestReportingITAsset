<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6fcbeff6-9cdf-43f3-8ec9-2925b6e420e8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parLicensName">
            <Value>=Parameters!parLicensName.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parLicenseID">
            <Value>=Parameters!parLicenseID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        LcID, CONVERT(nvarchar(10), LcID) AS LCIDStr, LicenseName, serial, purchase_order, purchase_date, expiration_date, license_email, purchase_cost, order_number, notes, AssetsName, license_name, seats, LcSID, 
                         UserEmailName, ByName, ByFullName, UserName, UserFullName
FROM            v_License
WHERE        (LicenseName LIKE N'%' + @parLicensName + N'%') AND (CONVERT(nvarchar(10), LcID) LIKE @parLicenseID)
ORDER BY LicenseName</CommandText>
      </Query>
      <Fields>
        <Field Name="LicenseName">
          <DataField>LicenseName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
