<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>e1db71fd-7015-48cf-8285-a604d6a91afc</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parLoc">
            <Value>=Parameters!parLoc.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parOfficeLoc">
            <Value>=Parameters!parOfficeLoc.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parUserStatus">
            <Value>=Parameters!parUserStatus.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parDisplayName">
            <Value>=Parameters!parDisplayName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        userPrincipalName, displayName, mail, givenName, surname, jobTitle, department, accountEnabled, officeLocation, companyName, LastUpdate, state, city, CreatedDate
FROM            vUserOnAzure
WHERE        (companyName IN (@parLoc)) AND (officeLocation IN (@parOfficeLoc)) AND (accountEnabled = @parUserStatus) AND (displayName LIKE CASE WHEN len(@parDisplayName) 
                         = 0 THEN '%' ELSE '%' + @parDisplayName + '%' END)
ORDER BY displayName, officeLocation, companyName</CommandText>
      </Query>
      <Fields>
        <Field Name="userPrincipalName">
          <DataField>userPrincipalName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="displayName">
          <DataField>displayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="mail">
          <DataField>mail</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="givenName">
          <DataField>givenName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="surname">
          <DataField>surname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="jobTitle">
          <DataField>jobTitle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="department">
          <DataField>department</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="accountEnabled">
          <DataField>accountEnabled</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="officeLocation">
          <DataField>officeLocation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="companyName">
          <DataField>companyName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastUpdate">
          <DataField>LastUpdate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="state">
          <DataField>state</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="city">
          <DataField>city</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CreatedDate">
          <DataField>CreatedDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLoc">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parOfficeLoc">
            <Value>=Parameters!parOfficeLoc.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT COALESCE (companyName, N'No Location') AS Location
FROM     vUserOnAzure
WHERE  (officeLocation IN (@parOfficeLoc))
GROUP BY COALESCE (companyName, N'No Location')</CommandText>
      </Query>
      <Fields>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datOfficeLoc">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT DISTINCT COALESCE (officeLocation, N'No Location') AS OfficeLocation
FROM     vUserOnAzure
GROUP BY COALESCE (officeLocation, N'No Location')</CommandText>
      </Query>
      <Fields>
        <Field Name="OfficeLocation">
          <DataField>OfficeLocation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
