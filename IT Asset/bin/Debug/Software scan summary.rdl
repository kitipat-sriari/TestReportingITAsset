<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2b7339b7-3503-4c6f-824b-b9c1f8b5fe74</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT   SupportBy, Company, Totalcom, TotalScan, MaxCalDate, CASE WHEN Totalcom - COALESCE (TotalScan, 0) - COALESCE (TotalNotScan, 0) 
                         &lt; 0 THEN 0 ELSE Totalcom - COALESCE (TotalScan, 0) - COALESCE (TotalNotScan, 0) END AS TotalScanRemain, TotalNotScan, LocSort, CalDate
FROM         v_SWScanSumCompany
ORDER BY LocSort</CommandText>
      </Query>
      <Fields>
        <Field Name="SupportBy">
          <DataField>SupportBy</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalCom">
          <DataField>Totalcom</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TotalScan">
          <DataField>TotalScan</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MaxCalDate">
          <DataField>MaxCalDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TotalScanRemain">
          <DataField>TotalScanRemain</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TotalNotScan">
          <DataField>TotalNotScan</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="LocSort">
          <DataField>LocSort</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CalDate">
          <DataField>CalDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datSWScanCur">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT SoftwareScanCur
FROM     v_SWScanMonthCur</CommandText>
      </Query>
      <Fields>
        <Field Name="SoftwareScanCur">
          <DataField>SoftwareScanCur</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
