<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>fbe49946-ef83-4c72-9f3e-c3d043e4d2a2</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parDate">
            <Value>=Parameters!parDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parOS">
            <Value>=Parameters!parOS.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Hostname, UserName, Location, CalDate, FirstSeen, LastSeen, AgentVersion, Status, MACAddress, InternalIPAddress, LastPublicIP, WindowsFullOS, Remark
FROM            WebRoot
WHERE        (LastSeen &gt;= @parDate) AND (WindowsFullOS LIKE @parOS)
ORDER BY Location, Hostname</CommandText>
      </Query>
      <Fields>
        <Field Name="Hostname">
          <DataField>Hostname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UserName">
          <DataField>UserName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CalDate">
          <DataField>CalDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="FirstSeen">
          <DataField>FirstSeen</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="LastSeen">
          <DataField>LastSeen</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="AgentVersion">
          <DataField>AgentVersion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MACAddress">
          <DataField>MACAddress</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InternalIPAddress">
          <DataField>InternalIPAddress</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastPublicIP">
          <DataField>LastPublicIP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WindowsFullOS">
          <DataField>WindowsFullOS</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remark">
          <DataField>Remark</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datOS">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        '---All---' AS OSLab, '%' AS OSVal, 1 AS OSSort
UNION
SELECT        'Windows 10' AS OSLab, 'Windows 10%' AS OSVal, 2 AS OSSort
UNION
SELECT        'Windows 11' AS OSLab, 'Windows 11%' AS OSVal, 3 AS OSSort
UNION
SELECT        'Windows 7' AS OSLab, 'Windows 7%' AS OSVal, 4 AS OSSort
UNION
SELECT        'Windows 8' AS OSLab, 'Windows 8%' AS OSVal, 5 AS OSSort
UNION
SELECT        'Windows Server ' AS OSLab, 'Windows Server%' AS OSVal, 6 AS OSSort
UNION
SELECT        'macOS' AS OSLab, 'macOS%' AS OSVal, 7 AS OSSort</CommandText>
      </Query>
      <Fields>
        <Field Name="OSLab">
          <DataField>OSLab</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OSVal">
          <DataField>OSVal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OSSort">
          <DataField>OSSort</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
