<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>143d6e34-3846-4ad5-b3b3-aa01cd223b56</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parPurYear">
            <Value>=Parameters!parPurYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parLoc">
            <Value>=Parameters!parLoc.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parCategory">
            <Value>=Parameters!parCategory.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parAssetName">
            <Value>=Parameters!parAssetName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Assets_Report.Company, Assets_Report.Location, Assets_Report.Category, CONVERT(decimal, CASE WHEN (DATEDIFF(mm, Purchased, { fn NOW() })) &lt; 0 THEN 0 ELSE (DATEDIFF(mm, Purchased, { fn NOW() })) END) 
                         / 12 AS PurYears, Assets_Report.Plan_Update, Assets_Report.Asset_Name, Assets_Report.Asset_Tag, Assets_Report.Username, Assets_Report.Model, Assets_Report.Model_No, Assets_Report.Purchased, 
                         Assets_Report.CPU, Assets_Report.HDD1, Assets_Report.RAM1, Assets_Report.HDD2, Assets_Report.RAM2, Assets_Report.Manager, Assets_Report.Department, Assets_Report.Status, Config.ConfigNo, 
                         Config_1.ConfigNo AS CompanyNo, Config_1.ConfigInt1
FROM            Assets_Report INNER JOIN
                         Config ON Assets_Report.Category = Config.ConfigStr1 INNER JOIN
                         Config AS Config_1 ON Assets_Report.Company = Config_1.ConfigStr1
WHERE        (CONVERT(decimal, CASE WHEN (DATEDIFF(mm, Purchased, { fn NOW() })) &lt; 0 THEN 0 ELSE (DATEDIFF(mm, Purchased, { fn NOW() })) END) / 12 &gt;= @parPurYear) AND (NOT (Assets_Report.Status LIKE N'Archived%')) AND 
                         (Config.ConfigNo = 1) AND (Assets_Report.Location IN (@parLoc)) AND (Assets_Report.Category IN (@parCategory)) AND (Assets_Report.Asset_Name LIKE N'%' + @parAssetName + N'%') AND (CONVERT(decimal, 
                         CASE WHEN (DATEDIFF(mm, Purchased, { fn NOW() })) &lt; 0 THEN 0 ELSE (DATEDIFF(mm, Purchased, { fn NOW() })) END) / 12 &gt;= @parPurYear) AND (Config_1.ConfigNo = 2)
ORDER BY Assets_Report.Company, Assets_Report.Location, PurYears DESC, Assets_Report.Category</CommandText>
      </Query>
      <Fields>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Asset_Name">
          <DataField>Asset_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Asset_Tag">
          <DataField>Asset_Tag</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PurYears">
          <DataField>PurYears</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Username">
          <DataField>Username</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Model">
