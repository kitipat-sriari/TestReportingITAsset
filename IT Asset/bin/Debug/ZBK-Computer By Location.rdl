          <DataField>Model_No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Purchased">
          <DataField>Purchased</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="CPU">
          <DataField>CPU</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="HDD1">
