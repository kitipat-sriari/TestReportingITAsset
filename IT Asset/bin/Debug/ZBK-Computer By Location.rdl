          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RAM2">
          <DataField>RAM2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Manager">
          <DataField>Manager</DataField>
