        <Field Name="Department">
          <DataField>Department</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ConfigNo">
          <DataField>ConfigNo</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="Plan_Update">
          <DataField>Plan_Update</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CompanyNo">
          <DataField>CompanyNo</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="ConfigInt1">
          <DataField>ConfigInt1</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLoc">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        Location
FROM            v_Location</CommandText>
      </Query>
      <Fields>
