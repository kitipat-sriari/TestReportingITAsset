<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>fd035766-d62e-4c36-b961-d63e8cfafc4f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parComName">
            <Value>=Parameters!parComName.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parLoc">
            <Value>=Parameters!parLoc.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT v_SWScanCurrentHistory_NewInstall.CompanyNameCurrent, v_SWScanCurrentHistory_NewInstall.ComNameCurrent, v_SWScanCurrentHistory_NewInstall.SoftwareNameCurrent, v_SWScanType.SoftwareType, 
                  v_SWScanCurrentHistory_NewInstall.CalDate, v_SWScanCurrentHistory_NewInstall.ScanDate, v_SWScanCurrentHistory_NewInstall.InstalledDateCurrent
FROM     v_SWScanType RIGHT OUTER JOIN
                  v_SWScanCurrentHistory_NewInstall ON v_SWScanType.SoftwareName = v_SWScanCurrentHistory_NewInstall.SoftwareNameCurrent
WHERE  (v_SWScanCurrentHistory_NewInstall.ComNameCurrent LIKE CASE WHEN @parComName = '' THEN '%' ELSE '%' + @parComName + '%' END) AND (v_SWScanCurrentHistory_NewInstall.CompanyNameCurrent IN (@parLoc))
ORDER BY v_SWScanCurrentHistory_NewInstall.CompanyNameCurrent, v_SWScanCurrentHistory_NewInstall.ComNameCurrent, v_SWScanCurrentHistory_NewInstall.SoftwareNameCurrent</CommandText>
      </Query>
      <Fields>
        <Field Name="CompanyNameCurrent">
          <DataField>CompanyNameCurrent</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComNameCurrent">
          <DataField>ComNameCurrent</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SoftwareNameCurrent">
          <DataField>SoftwareNameCurrent</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SoftwareType">
          <DataField>SoftwareType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CalDate">
          <DataField>CalDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="ScanDate">
          <DataField>ScanDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="InstalledDateCurrent">
          <DataField>InstalledDateCurrent</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLocSub">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT LocationSub AS SupportMainVal, LocationSub AS SupportMainLab
FROM     v_ConfigLocMainLocSub</CommandText>
      </Query>
      <Fields>
        <Field Name="SupportMainVal">
          <DataField>SupportMainVal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SupportMainLab">
          <DataField>SupportMainLab</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datSWScanMonth">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT SoftwareScanCur + ' And ' + SoftwareScanHistory AS SoftwareScan
FROM     v_SWScanMonth</CommandText>
      </Query>
      <Fields>
        <Field Name="SoftwareScan">
          <DataField>SoftwareScan</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
