                            <Textbox Name="Textbox40">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>       ในกรณีชาวไร่อ้อยส่งอ้อยเข้าหีบผ่านข้าพเจ้าในฐานะหัวหน้ากลุ่มชาวไร่อ้อยและเป็นคู่สัญญากับโรงงานน้ำตาลทราย</Value>
                                      <Style>
                                        <FontFamily>BrowalliaUPC</FontFamily>
                                        <FontSize>15pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox14</rd:DefaultName>
                              <Top>3.77951in</Top>
                              <Left>0.04603in</Left>
                              <Height>0.25in</Height>
                              <Width>7.01566in</Width>
                              <ZIndex>23</ZIndex>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>1pt</PaddingLeft>
                                <PaddingRight>1pt</PaddingRight>
                                <PaddingTop>1pt</PaddingTop>
                                <PaddingBottom>1pt</PaddingBottom>
                              </Style>
                            </Textbox>
                            <Textbox Name="Textbox41">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>เมื่อข้าพเจ้าได้รับเงินช่วยเหลือเพิ่มค่าอ้อยแล้ว   ข้าพเจ้ารับว่าจะนำเงินดังกล่าวมอบให้แก่ชาวไร่อ้อยที่ส่งอ้อยผ่านข้าพเจ้า</Value>
                                      <Style>
                                        <FontFamily>BrowalliaUPC</FontFamily>
                                        <FontSize>15pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox14</rd:DefaultName>
                              <Top>4.0434in</Top>
                              <Left>0.11693cm</Left>
                              <Height>0.25in</Height>
                              <Width>7.01565in</Width>
                              <ZIndex>24</ZIndex>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>1pt</PaddingLeft>
                                <PaddingRight>1pt</PaddingRight>
                                <PaddingTop>1pt</PaddingTop>
                                <PaddingBottom>1pt</PaddingBottom>
                              </Style>
                            </Textbox>
                            <Textbox Name="Textbox42">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>ครบถ้วนทุกตันอ้อย</Value>
                                      <Style>
                                        <FontFamily>BrowalliaUPC</FontFamily>
                                        <FontSize>15pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox14</rd:DefaultName>
                              <Top>4.2934in</Top>
                              <Left>0.11693cm</Left>
                              <Height>0.25in</Height>
                              <Width>7.01565in</Width>
                              <ZIndex>25</ZIndex>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>1pt</PaddingLeft>
                                <PaddingRight>1pt</PaddingRight>
                                <PaddingTop>1pt</PaddingTop>
                                <PaddingBottom>1pt</PaddingBottom>
                              </Style>
                            </Textbox>
                            <Textbox Name="Textbox43">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>       ข้าพเจ้ายินยอมให้กองทุนอ้อยและน้ำตาลทรายบันทึกบัญชีให้ข้าพเจ้าเป็นลูกหนี้ของกองทุนอ้อยและ น้ำตาลทราย</Value>
                                      <Style>
                                        <FontFamily>BrowalliaUPC</FontFamily>
                                        <FontSize>15pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox14</rd:DefaultName>
                              <Top>4.55729in</Top>
                              <Left>0.04603in</Left>
                              <Height>0.25in</Height>
                              <Width>7.01566in</Width>
                              <ZIndex>26</ZIndex>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>1pt</PaddingLeft>
                                <PaddingRight>1pt</PaddingRight>
                                <PaddingTop>1pt</PaddingTop>
                                <PaddingBottom>1pt</PaddingBottom>
                              </Style>
                            </Textbox>
                            <Textbox Name="Textbox44">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>ตามจำนวนเงินที่ได้รับข้างต้น และจะหักล้างบัญชีลูกหนี้โดยถือว่าเงินที่ข้าพเจ้าได้รับดังกล่าวเป็นเงินที่ได้รับจากกองทุนอ้อย</Value>
                                      <Style>
                                        <FontFamily>BrowalliaUPC</FontFamily>
                                        <FontSize>15pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
