          </QueryParameter>
          <QueryParameter Name="@Quota">
            <Value>=Parameters!Quota.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Zone">
            <Value>=join(Parameters!Zone.Value,",")</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RptGoverment_PayHelpFarmerCal @Ton,@DateStart,@DateEnd,@Quota,@Zone,4</CommandText>
