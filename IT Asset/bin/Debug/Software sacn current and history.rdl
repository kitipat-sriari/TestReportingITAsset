<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>89904353-5931-4f85-bbc5-364f3df844e6</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parLocMain">
            <Value>=Parameters!parLocMain.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parSoftwareHit">
            <Value>=Parameters!parSoftwareHit.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parSWInstall">
            <Value>=Parameters!parSWInstall.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT   v_SWScanCurrentHistory.CompanyNameCurrent, v_SWScanCurrentHistory.ComNameCurrent, v_SWScanCurrentHistory.SoftwareNameCurrent, 
                         v_SWScanCurrentHistory.CompanyNameHistory, v_SWScanCurrentHistory.ComNameHistory, v_SWScanCurrentHistory.SoftwareNameHistory, v_SWScanCurrentHistory.CalDate, 
                         v_SWScanCurrentHistory.InstalledDateHistory, v_SWScanCurrentHistory.InstalledDateCurrent
FROM         v_SWScanCurrentHistory INNER JOIN
                         v_SWScanCurrentHistory_NewInstallSum ON v_SWScanCurrentHistory.CompanyNameCurrent = v_SWScanCurrentHistory_NewInstallSum.LocName AND 
                         v_SWScanCurrentHistory.ComNameCurrent = v_SWScanCurrentHistory_NewInstallSum.ComNameCurrent
WHERE     (v_SWScanCurrentHistory.CompanyNameCurrent LIKE @parLocMain) AND (v_SWScanCurrentHistory.SoftwareNameHistory LIKE @parSoftwareHit) AND 
                         (CASE WHEN SumSW &lt;= 3 THEN 'SomeSW' ELSE 'NewCom' END LIKE @parSWInstall)</CommandText>
      </Query>
      <Fields>
        <Field Name="CompanyNameCurrent">
          <DataField>CompanyNameCurrent</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComNameCurrent">
          <DataField>ComNameCurrent</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SoftwareNameCurrent">
          <DataField>SoftwareNameCurrent</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CompanyNameHistory">
          <DataField>CompanyNameHistory</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComNameHistory">
          <DataField>ComNameHistory</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SoftwareNameHistory">
          <DataField>SoftwareNameHistory</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CalDate">
          <DataField>CalDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="InstalledDateHistory">
          <DataField>InstalledDateHistory</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="InstalledDateCurrent">
          <DataField>InstalledDateCurrent</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLocMainLocSub">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT   SupportMain
FROM         v_ConfigLocMainLocSub
GROUP BY SupportMain</CommandText>
      </Query>
      <Fields>
        <Field Name="SupportMain">
          <DataField>SupportMain</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
