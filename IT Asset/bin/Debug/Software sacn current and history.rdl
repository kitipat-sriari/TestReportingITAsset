  <ReportParameters>
    <ReportParameter Name="parLocMain">
      <DataType>String</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>datLocMainLocSub</DataSetName>
          <ValueField>SupportMain</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Location Main :</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>datLocMainLocSub</DataSetName>
          <ValueField>SupportMain</ValueField>
          <LabelField>SupportMain</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="parSoftwareHit">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>="-"</Value>
        </Values>
      </DefaultValue>
      <Prompt>Software History :</Prompt>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Value>%</Value>
            <Label>---All---</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>="-"</Value>
            <Label>Null</Label>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="parSWInstall">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>SomeSW</Value>
        </Values>
      </DefaultValue>
      <Prompt>SW Install(&gt;) :</Prompt>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Value>="NewCom"</Value>
            <Label>For new Com</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>="SomeSW"</Value>
            <Label>Some Software</Label>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>
  </ReportParameters>
