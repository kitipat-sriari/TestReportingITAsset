          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RAM1">
          <DataField>RAM1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UserName">
          <DataField>UserName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ByName">
          <DataField>ByName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
