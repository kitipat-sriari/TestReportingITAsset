        </Field>
        <Field Name="CategoryGroup">
          <DataField>CategoryGroup</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CategoryName">
          <DataField>CategoryName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Purchased">
          <DataField>Purchased</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datStatus">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT Status AS StatusVal, Status AS StatusLab, '02' AS StatusSort
FROM     v_Status
</CommandText>
      </Query>
      <Fields>
        <Field Name="StatusVal">
          <DataField>StatusVal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StatusLab">
          <DataField>StatusLab</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StatusSort">
          <DataField>StatusSort</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datGroupDetail">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parGroupHead">
            <Value>=Parameters!parGroupHead.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT CategoryName AS GroupDetailLab, CategoryName AS GroupDetailVal, '02' AS GroupDetailSort
FROM     v_CategoryGrouping
WHERE  (CategoryGroup LIKE @parGroupHead)
UNION
SELECT '---All---' AS GroupDetailLab, '%' AS GroupDetailVal, '01' AS GroupDetailSort
ORDER BY GroupDetailSort</CommandText>
      </Query>
      <Fields>
        <Field Name="GroupDetailLab">
          <DataField>GroupDetailLab</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GroupDetailVal">
          <DataField>GroupDetailVal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GroupDetailSort">
          <DataField>GroupDetailSort</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datGroupHead">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT CategoryGroup AS GroupNameHeadVall, CategoryGroup AS GroupNameHeadLab, '02' AS GroupNameSort
FROM     v_CategoryGroupingHead
UNION
SELECT '%' AS GroupNameHeadVal, '---All---' AS GroupNameHeadLab, '01' AS GroupNameSort
ORDER BY GroupNameSort</CommandText>
      </Query>
      <Fields>
        <Field Name="GroupNameHeadVall">
          <DataField>GroupNameHeadVall</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GroupNameHeadLab">
          <DataField>GroupNameHeadLab</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GroupNameSort">
          <DataField>GroupNameSort</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLoc">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT Location
FROM     v_Location</CommandText>
      </Query>
      <Fields>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
