<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2fbd96bc-2fdd-47d2-9d60-e5a87181f535</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parGroupDetail">
            <Value>=Parameters!parGroupDetail.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parStatus">
            <Value>=Parameters!parStatus.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parGroupHead">
            <Value>=Parameters!parGroupHead.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parLoc">
            <Value>=Parameters!parLoc.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT id, Company, COALESCE (Location, N'') AS Location, Category, PurYears, Asset_Name, asset_tag, Model, Model_No, CPU, HDD1, RAM1, Status, UserName, ByName, SuppliersName, CategoryGroup, CategoryName, Purchased
FROM     v_AssetList
WHERE  (Category LIKE @parGroupDetail) AND (Status IN (@parStatus)) AND (CategoryGroup LIKE @parGroupHead) AND (COALESCE (Location, N'') IN (@parLoc))</CommandText>
      </Query>
      <Fields>
        <Field Name="id">
          <DataField>id</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PurYears">
          <DataField>PurYears</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Asset_Name">
          <DataField>Asset_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="asset_tag">
          <DataField>asset_tag</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
