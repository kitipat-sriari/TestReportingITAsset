<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8d5dd4e4-aae8-40ae-86b9-35998c9c00d5</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT v_SWScanByComName.CompanyName, v_SWScanByComName.ComName, v_SWScanByComName.MaxCalDate, v_CompanyGroup.CompanyMain, v_SWComSum.TotalMainCom, v_AssetComTotal.LocationSub AS ComLocatoionSub, 
                  v_AssetComTotal.LocationMain AS ComLocatoionMain, v_AssetComTotal.Totalcom AS ComQty
FROM     v_AssetComTotal INNER JOIN
                  v_SWComSum ON v_AssetComTotal.LocationMain = v_SWComSum.SuppportBy INNER JOIN
                  v_CompanyGroup INNER JOIN
                  v_SWScanByComName ON v_CompanyGroup.CompanySub = v_SWScanByComName.CompanyName ON v_AssetComTotal.LocationSub = v_CompanyGroup.CompanySub</CommandText>
      </Query>
      <Fields>
        <Field Name="CompanyName">
          <DataField>CompanyName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComName">
          <DataField>ComName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CompanyMain">
          <DataField>CompanyMain</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MaxCalDate">
          <DataField>MaxCalDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="ComLocatoionMain">
          <DataField>ComLocatoionMain</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComQty">
          <DataField>ComQty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ComLocatoionSub">
          <DataField>ComLocatoionSub</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalMainCom">
          <DataField>TotalMainCom</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
