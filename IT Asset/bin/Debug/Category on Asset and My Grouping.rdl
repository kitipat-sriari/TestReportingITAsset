    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT Category, Model, Model_No, CategoryGroup, CategoryName, Asset_Name, asset_tag
FROM     v_CategoryOnAssetAndMyGroup
ORDER BY Category, Model, Model_No</CommandText>
      </Query>
