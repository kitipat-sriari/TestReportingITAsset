<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>397a1a26-b345-4f96-93a7-ee5fcb7e9b26</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parLocSub">
            <Value>=Parameters!parLocSub.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parLC">
            <Value>=Parameters!parLC.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parDisplayName">
            <Value>=Parameters!parDisplayName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT displayName, JobTitle, Department, OfficeLoc, BeUnder, BusinessStandard AS BS, AppForBusiness AS AB, AppForEnterprise AS AE, MSTeam, DateLastModified AS LastUpdate, LastDateMSLicense AS LastUpdateLC, MSLcName1, 
                  CASE WHEN BusinessStandard = 'X' THEN 1 ELSE 0 END AS BSVal, CASE WHEN AppForBusiness = 'X' THEN 1 ELSE 0 END AS ABVal, CASE WHEN AppForEnterprise = 'X' THEN 1 ELSE 0 END AS AEVal, 
                  CASE WHEN MSTeam = 'X' THEN 1 ELSE 0 END AS MTVal, Remark, RenewWal, CASE WHEN RenewWal = 'X' THEN 1 ELSE 0 END AS RenewVal, CASE WHEN RenewWal = 'X' OR
                  AppForBusiness = 'X' THEN 'RenewAndNew' ELSE '' END AS Expr1
FROM     tempMS36Renew
WHERE  (displayName LIKE + N'%' + @parDisplayName + N'%') AND (BeUnder IN (@parLocSub)) AND (MSLcName1 LIKE N'%' + @parLC + N'%') AND (CASE WHEN RenewWal = 'X' OR
                  AppForBusiness = 'X' THEN 'RenewAndNew' ELSE '' END = 'RenewAndNew')
ORDER BY displayName</CommandText>
      </Query>
      <Fields>
        <Field Name="displayName">
          <DataField>displayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="JobTitle">
          <DataField>JobTitle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Department">
          <DataField>Department</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OfficeLoc">
          <DataField>OfficeLoc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BeUnder">
          <DataField>BeUnder</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BS">
