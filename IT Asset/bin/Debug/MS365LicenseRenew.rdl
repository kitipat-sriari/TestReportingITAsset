          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AB">
          <DataField>AB</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AE">
          <DataField>AE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MSTeam">
          <DataField>MSTeam</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastUpdate">
          <DataField>LastUpdate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastUpdateLC">
          <DataField>LastUpdateLC</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BSVal">
          <DataField>BSVal</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ABVal">
          <DataField>ABVal</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AEVal">
          <DataField>AEVal</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MTVal">
          <DataField>MTVal</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MSLcName1">
          <DataField>MSLcName1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remark">
          <DataField>Remark</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RenewWal">
          <DataField>RenewWal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RenewVal">
          <DataField>RenewVal</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Expr1">
          <DataField>Expr1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLocSub">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT LocationSub
FROM     v_ConfigLocMainLocSub</CommandText>
      </Query>
      <Fields>
        <Field Name="LocationSub">
          <DataField>LocationSub</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLC">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT MSLCName AS LCVal, MSLCName AS LCLab, '02' AS LCSort
FROM     v_ConfigMS365License
UNION
SELECT '%' AS LCVal, '---All---' AS LCLab, '01' AS LCSort
ORDER BY LCSort</CommandText>
      </Query>
      <Fields>
        <Field Name="LCVal">
          <DataField>LCVal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LCLab">
          <DataField>LCLab</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LCSort">
          <DataField>LCSort</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datMS365">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT BuyMSLicense
FROM     v_ConfigMS365LicenseBuy</CommandText>
      </Query>
      <Fields>
        <Field Name="BuyMSLicense">
          <DataField>BuyMSLicense</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
