<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>1b04df53-9173-4a11-93de-65d6b34d338f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parLicensName">
            <Value>=Parameters!parLicensName.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parExpireDate">
            <Value>=Parameters!parExpireDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        v_License_Sum.LicenseID, v_License_Sum.LicenseName, v_License_Sum.seats, v_License_Sum.serial, v_License_Sum.purchase_order, v_License_Sum.purchase_cost, v_License_Sum.purchase_date, 
                         CASE WHEN expiration_date = NULL THEN '01/01/9999' ELSE expiration_date END AS expiration_date, v_License_Sum.name, v_License_Sum.license_name, v_License_Sum.license_email, v_License_Sum.order_number, 
                         v_License_Sum.updated_at, v_License_Sum.notes, v_LicenseCount.TotalQty, v_LicenseCount.SumAssetQty, v_LicenseCount.SumUserQty
FROM            v_License_Sum INNER JOIN
                         v_LicenseCount ON v_License_Sum.LicenseID = v_LicenseCount.LcID
WHERE        (CASE WHEN COALESCE (expiration_date, '') = '' THEN '01/01/9999' ELSE expiration_date END &gt;= @parExpireDate) AND (v_License_Sum.LicenseName LIKE N'%' + @parLicensName + N'%')
ORDER BY v_License_Sum.LicenseName, v_License_Sum.LicenseID</CommandText>
      </Query>
      <Fields>
        <Field Name="LicenseID">
          <DataField>LicenseID</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="LicenseName">
          <DataField>LicenseName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="seats">
          <DataField>seats</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="serial">
          <DataField>serial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="purchase_order">
          <DataField>purchase_order</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="purchase_cost">
          <DataField>purchase_cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="purchase_date">
          <DataField>purchase_date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="expiration_date">
          <DataField>expiration_date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="name">
          <DataField>name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="license_name">
          <DataField>license_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="license_email">
          <DataField>license_email</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="order_number">
          <DataField>order_number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="updated_at">
          <DataField>updated_at</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="notes">
          <DataField>notes</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalQty">
          <DataField>TotalQty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SumAssetQty">
          <DataField>SumAssetQty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SumUserQty">
          <DataField>SumUserQty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
