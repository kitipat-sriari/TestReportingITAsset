<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>08dba67e-aba5-42f1-8a13-4e99f986ccb7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parLoc">
            <Value>=Parameters!parLoc.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT SoftwareNameCurrent, SUM(CountCom) AS CountCom, CompanyNameCurrent AS Location
FROM     v_SWInstallNew
GROUP BY SoftwareNameCurrent, CompanyNameCurrent
HAVING (CompanyNameCurrent IN (@parLoc))</CommandText>
      </Query>
      <Fields>
        <Field Name="SoftwareNameCurrent">
          <DataField>SoftwareNameCurrent</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CountCom">
          <DataField>CountCom</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datSWScanMonth">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT SoftwareScanCur + ' And ' + SoftwareScanHistory AS SWScan
FROM     v_SWScanMonth</CommandText>
      </Query>
      <Fields>
        <Field Name="SWScan">
          <DataField>SWScan</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLoc">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT CompanyName AS BeUnder
FROM     v_SWScanDetail
GROUP BY CompanyName
ORDER BY BeUnder</CommandText>
      </Query>
      <Fields>
        <Field Name="BeUnder">
          <DataField>BeUnder</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
