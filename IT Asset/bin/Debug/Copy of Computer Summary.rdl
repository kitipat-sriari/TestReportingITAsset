<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>4ae359bb-6313-450f-b7fa-f9eef3c0b5bb</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        v_ComputerSum.SupportBy, v_ComputerSum.Company, v_ComputerSum.Location, v_ComputerSum.TotalQty, v_ComputerSum.OnlineQty, v_ComputerSum.SpareQty, v_ComputerSum.Year0To1, v_ComputerSum.Year1To2, 
                         v_ComputerSum.Year2To3, v_ComputerSum.Year3To4, v_ComputerSum.Year4To5, v_ComputerSum.Year5Up, v_ComputerSum.QtyRep, v_ComputerSum.QtyUp, v_ComPlanToUpgradeSum.ComDesktop, 
                         v_ComPlanToUpgradeSum.ComNUC, v_ComPlanToUpgradeSum.ComNotebook
FROM            v_ComputerSum LEFT OUTER JOIN
                         v_ComPlanToUpgradeSum ON v_ComputerSum.SupportBy = v_ComPlanToUpgradeSum.SupportBy AND v_ComputerSum.Company = v_ComPlanToUpgradeSum.Company AND 
                         v_ComputerSum.Location = v_ComPlanToUpgradeSum.Location
ORDER BY v_ComputerSum.SupportBy, v_ComputerSum.Company</CommandText>
      </Query>
      <Fields>
        <Field Name="SupportBy">
          <DataField>SupportBy</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalQty">
          <DataField>TotalQty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OnlineQty">
          <DataField>OnlineQty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SpareQty">
          <DataField>SpareQty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Year0To1">
          <DataField>Year0To1</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Year1To2">
          <DataField>Year1To2</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Year2To3">
          <DataField>Year2To3</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Year3To4">
          <DataField>Year3To4</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Year4To5">
          <DataField>Year4To5</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Year5Up">
          <DataField>Year5Up</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="QtyRep">
          <DataField>QtyRep</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="QtyUp">
          <DataField>QtyUp</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ComDesktop">
          <DataField>ComDesktop</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ComNUC">
          <DataField>ComNUC</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ComNotebook">
          <DataField>ComNotebook</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datCompany">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        Company AS CompName, CompanyCode AS CompCode
FROM            v_Company
ORDER BY CompCode</CommandText>
      </Query>
      <Fields>
        <Field Name="CompName">
          <DataField>CompName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CompCode">
          <DataField>CompCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLocation">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        Location
FROM            v_Location</CommandText>
      </Query>
      <Fields>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datCategory">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT CategoryName AS Category
FROM     v_Category01Computer</CommandText>
      </Query>
      <Fields>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
