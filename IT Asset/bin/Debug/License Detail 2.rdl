          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="seats">
          <DataField>seats</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AssetsNameNew">
          <DataField>AssetsNameNew</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LcSID">
          <DataField>LcSID</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="license_name">
