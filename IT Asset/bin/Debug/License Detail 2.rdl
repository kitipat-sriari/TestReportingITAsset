<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6fcbeff6-9cdf-43f3-8ec9-2925b6e420e8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parLicensName">
            <Value>=Parameters!parLicensName.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parExpireDate">
            <Value>=Parameters!parExpireDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        LcID, CONVERT(nvarchar(10), LcID) AS LCIDStr, LcSID, LicenseName, serial, purchase_order, purchase_date, expiration_date, license_email, purchase_cost, order_number, notes, COALESCE (AssetsName, N'') 
                         AS AssetsNameNew, license_name, seats, UserEmailName, ByName, ByFullName, COALESCE (UserName, N'') AS UserNameNew, UserFullName
FROM            v_License
WHERE        (LicenseName LIKE N'%' + @parLicensName + N'%') AND (CASE WHEN COALESCE (expiration_date, '') = '' THEN '01/01/9999' ELSE expiration_date END &gt;= @parExpireDate)
ORDER BY LcSID, LicenseName, AssetsNameNew DESC, UserNameNew</CommandText>
      </Query>
      <Fields>
        <Field Name="LicenseName">
          <DataField>LicenseName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LCIDStr">
          <DataField>LCIDStr</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="serial">
          <DataField>serial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="purchase_order">
          <DataField>purchase_order</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="purchase_date">
