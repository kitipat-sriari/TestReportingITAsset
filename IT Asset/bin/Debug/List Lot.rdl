  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datERP85</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parItemID">
            <Value>=Parameters!parItemID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parBatchNo">
            <Value>=Parameters!parBatchNo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parWH">
            <Value>=Parameters!parWH.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parLoc">
            <Value>=Parameters!parLoc.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parItemClass">
            <Value>=Parameters!parItemClass.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parProdFam">
            <Value>=Parameters!parProdFam.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parItemTypeCode">
            <Value>=Parameters!parItemTypeCode.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parItemStyle">
            <Value>=Parameters!parItemStyle.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        LLT_MasterWarehouse.MWH_WhsName, LLT_MasterLocation.MWL_LocationName, LLT_MasterLot.MLT_ItemID, LLT_MasterLot.MLT_LotNbr, LOC.LOC_LocQty, LOT.LOT_LotQty, LLT_MasterWarehouse.MWH_ID, 
                         Item.IMA_ItemName, LLT_MasterLot.MLT_MstrCreatedDate, CASE WHEN ITLLastDate.LotTransDate IS NULL THEN LLT_MasterLot.MLT_MstrCreatedDate ELSE ITLLastDate.LotTransDate END AS LastTranDate, 
                         ITLLastDate.LotTransDate, Item.IMA_Classification, Item.IMA_ProdFam, Item.IMA_ItemTypeCode, LLT_MasterLot.MLT_TypeCode, LLT_MasterLot.MLT_LotCode, LOT.LOT_UserDef3, Item.IMA_LotPromptFlag, 
                         COALESCE (Item.IMA_CommodityCode, N'') AS ItemStyle
FROM            LLT_MasterLot INNER JOIN
                         LLT_MasterWarehouse INNER JOIN
                         LOT INNER JOIN
                         LOC INNER JOIN
                         LLT_MasterLocation ON LOC.LOC_MWL_ID = LLT_MasterLocation.MWL_ID ON LOT.LOT_LOC_ID = LOC.LOC_ID ON LLT_MasterWarehouse.MWH_ID = LLT_MasterLocation.MWL_MWH_ID ON 
                         LLT_MasterLot.MLT_ID = LOT.LOT_MLT_ID INNER JOIN
                         Item ON LOC.LOC_ItemID = Item.IMA_ItemID LEFT OUTER JOIN
                             (SELECT        ITL_LOT_ID, MAX(ITL_LotTransDate) AS LotTransDate
                               FROM            ITL
                               GROUP BY ITL_LOT_ID) AS ITLLastDate ON LOT.LOT_ID = ITLLastDate.ITL_LOT_ID
WHERE        (LLT_MasterLot.MLT_ItemID LIKE CASE WHEN (@parItemID = NULL) OR
                         (Len(@parItemID) = 0) THEN '%' ELSE @parItemID END) AND (LLT_MasterWarehouse.MWH_WhsName LIKE @parWH) AND (LLT_MasterLot.MLT_LotNbr LIKE CASE WHEN (@parBatchNo = NULL) OR
                         (Len(@parBatchNo) = 0) THEN '%' ELSE @parBatchNo END) AND (LLT_MasterLocation.MWL_LocationName LIKE @parLoc) AND (Item.IMA_Classification LIKE @parItemClass) AND (Item.IMA_ProdFam LIKE @parProdFam) AND 
                         (Item.IMA_ItemTypeCode LIKE @parItemTypeCode) AND (COALESCE (Item.IMA_CommodityCode, N'') LIKE CASE WHEN (@parItemStyle = NULL) OR
                         (Len(@parItemStyle) = 0) THEN '%' ELSE @parItemStyle END) AND (LOT.LOT_LotQty &lt;&gt; 0)
ORDER BY LLT_MasterWarehouse.MWH_WhsName, LLT_MasterLot.MLT_ItemID</CommandText>
      </Query>
      <Fields>
        <Field Name="MWH_WhsName">
          <DataField>MWH_WhsName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MWL_LocationName">
          <DataField>MWL_LocationName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MLT_ItemID">
          <DataField>MLT_ItemID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MLT_LotNbr">
          <DataField>MLT_LotNbr</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOC_LocQty">
          <DataField>LOC_LocQty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="LOT_LotQty">
          <DataField>LOT_LotQty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="MWH_ID">
          <DataField>MWH_ID</DataField>
          <rd:TypeName>System.Guid</rd:TypeName>
        </Field>
        <Field Name="IMA_ItemName">
          <DataField>IMA_ItemName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MLT_MstrCreatedDate">
          <DataField>MLT_MstrCreatedDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
