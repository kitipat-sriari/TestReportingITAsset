          <DataField>LastTranDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="LotTransDate">
          <DataField>LotTransDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="IMA_Classification">
          <DataField>IMA_Classification</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IMA_ProdFam">
          <DataField>IMA_ProdFam</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IMA_ItemTypeCode">
          <DataField>IMA_ItemTypeCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MLT_TypeCode">
          <DataField>MLT_TypeCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MLT_LotCode">
          <DataField>MLT_LotCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOT_UserDef3">
          <DataField>LOT_UserDef3</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IMA_LotPromptFlag">
          <DataField>IMA_LotPromptFlag</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="ItemStyle">
          <DataField>ItemStyle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
