    <DataSet Name="datStyle">
      <Query>
        <DataSourceName>datERP85</DataSourceName>
        <CommandText>SELECT        MMTS_Value AS ItemStyleVal, MMTS_Value AS ItemStyleLabel, '02' AS ItemStyleSort
FROM            MMTS
WHERE        (MMTS_Type = 'MMTS_CommodityCode') AND (MMTS_ActiveFlag = 1)
UNION
SELECT        '%' AS ItemStyleVal, '---All---' AS ItemStyleLabel, '01' AS ItemStyleSort
ORDER BY ItemStyleSort</CommandText>
      </Query>
      <Fields>
        <Field Name="ItemStyleVal">
          <DataField>ItemStyleVal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ItemStyleLabel">
          <DataField>ItemStyleLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ItemStyleSort">
          <DataField>ItemStyleSort</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
