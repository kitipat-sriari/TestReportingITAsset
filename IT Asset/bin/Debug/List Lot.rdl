    <DataSet Name="datLoc">
      <Query>
        <DataSourceName>datERP85</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parWH">
            <Value>=Parameters!parWH.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parItemTypeCode">
            <Value>=Parameters!parItemTypeCode.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        LLT_MasterLocation.MWL_LocationName AS LocNameLabel, LLT_MasterLocation.MWL_LocationName AS LocName, '02' AS LOCSort
FROM            LLT_MasterLocation INNER JOIN
                         LLT_MasterWarehouse ON LLT_MasterLocation.MWL_MWH_ID = LLT_MasterWarehouse.MWH_ID
WHERE        (LLT_MasterWarehouse.MWH_WhsName LIKE @parWH) AND (LLT_MasterLocation.MWL_LocationName NOT LIKE N'WIPIns%') AND 
                         (LLT_MasterWarehouse.MWH_WhsCode LIKE @parItemTypeCode) AND (LLT_MasterLocation.MWL_ArchiveDate IS NULL)
UNION
SELECT        '---All---' AS LocNameLabel, '%' AS LocName, '01' AS LOCSort
ORDER BY LOCSort</CommandText>
      </Query>
      <Fields>
        <Field Name="LocNameLabel">
          <DataField>LocNameLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LocName">
          <DataField>LocName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOCSort">
          <DataField>LOCSort</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
