  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6f179ba4-f39b-4ad5-b3aa-10527e9fc8ec</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        v_ConfigLocMainLocSub.SupportMain AS SupportBy, v_ConfigLocMainLocSub.LocationSub AS Location, v_SWScanByComName_CannotScan.ComNameCanNotScan, v_SWScanByComName_CannotScan.Publisher
FROM            v_SWScanByComName_CannotScan INNER JOIN
                         v_ConfigLocMainLocSub ON v_SWScanByComName_CannotScan.CompanyName = v_ConfigLocMainLocSub.LocationSub</CommandText>
      </Query>
      <Fields>
        <Field Name="SupportBy">
          <DataField>SupportBy</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComNameCanNotScan">
          <DataField>ComNameCanNotScan</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Publisher">
          <DataField>Publisher</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLocMainSub">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        SupportMain
FROM            v_ConfigLocMainLocSub
GROUP BY SupportMain</CommandText>
      </Query>
      <Fields>
        <Field Name="SupportMain">
          <DataField>SupportMain</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
