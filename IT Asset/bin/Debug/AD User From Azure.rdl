  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        userPrincipalName, displayName, mail, givenName, surname, jobTitle, department, accountEnabled, officeLocation, companyName, LastUpdate, createdDateTime
FROM            vUserOnAzure
ORDER BY displayName, companyName</CommandText>
      </Query>
