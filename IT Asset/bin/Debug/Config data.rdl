<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>20d8ed38-5a23-4073-b9ac-83fceb07dfe1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parConfigName">
            <Value>=Parameters!parConfigName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT ConfigID, ConfigNo, ConfigName, ConfigStr1, ConfigInt1, ConfigVal1, ConfigRemark, ConfigStr2
FROM     v_Config
WHERE  (ConfigName IN (@parConfigName))
ORDER BY ConfigNo, ConfigName</CommandText>
      </Query>
      <Fields>
        <Field Name="ConfigID">
          <DataField>ConfigID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ConfigNo">
          <DataField>ConfigNo</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="ConfigName">
          <DataField>ConfigName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ConfigStr1">
          <DataField>ConfigStr1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ConfigInt1">
          <DataField>ConfigInt1</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ConfigVal1">
          <DataField>ConfigVal1</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ConfigRemark">
          <DataField>ConfigRemark</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ConfigStr2">
          <DataField>ConfigStr2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datConfigNo">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT ConfigName
FROM     v_Config
GROUP BY ConfigName</CommandText>
      </Query>
      <Fields>
        <Field Name="ConfigName">
          <DataField>ConfigName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
