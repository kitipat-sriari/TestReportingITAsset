  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        SupportBy, Company, Location, TotalQty
FROM            v_ComputerSumBySupport
ORDER BY SupportBy, Company</CommandText>
      </Query>
      <Fields>
        <Field Name="SupportBy">
          <DataField>SupportBy</DataField>
          <rd:TypeName>System.String</rd:TypeName>
