        <CommandText>SELECT        SupportBy
FROM            v_SupportBy</CommandText>
      </Query>
      <Fields>
        <Field Name="SupportBy">
          <DataField>SupportBy</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
