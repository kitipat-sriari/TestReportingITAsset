<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <FullPath>Debug</FullPath>
    <OutputPath>bin\Debug</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>True</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>ITAsset</TargetReportFolder>
    <TargetDatasetFolder>ITAsset</TargetDatasetFolder>
    <TargetDatasourceFolder>ITAsset</TargetDatasourceFolder>
    <TargetReportPartFolder>ITAsset</TargetReportPartFolder>
    <TargetServerURL>http://dbgobi.trrsugar.com/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'DebugLocal' ">
    <FullPath>DebugLocal</FullPath>
    <OutputPath>bin\DebugLocal</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>IT Asset</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <FullPath>Release</FullPath>
    <OutputPath>bin\Release</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>IT Asset</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup>
    <State>$base64$</State>
    <DataSources>@(DataSource)</DataSources>
    <DataSets>@(DataSet)</DataSets>
    <Reports>@(Report)</Reports>
  </PropertyGroup>
  <ItemGroup>
    <DataSource Include="datITAsset.rds" />
  </ItemGroup>
  <ItemGroup>
    <Report Include="Asset List.rdl" />
    <Report Include="Asset Status.rdl" />
    <Report Include="Azure Active Directory.rdl" />
    <Report Include="Category on Asset and on Report.rdl" />
    <Report Include="Checking Asset name is double.rdl" />
    <Report Include="Checking Asset No Location.rdl" />
    <Report Include="Checking Category on Asset and GB.rdl" />
    <Report Include="ComName and UserName from Webroot.rdl" />
    <Report Include="Computer By Location.rdl" />
    <Report Include="Computer List All.rdl" />
    <Report Include="Computer Name.rdl" />
    <Report Include="Computer plan to upgrade summary.rdl" />
    <Report Include="Computer plan to upgrade-V2Group.rdl" />
    <Report Include="Computer plan to upgrade.rdl" />
    <Report Include="Computer Summary by Category.rdl" />
    <Report Include="Computer Summary.rdl" />
    <Report Include="Config data.rdl" />
    <Report Include="License Detail Report.rdl" />
    <Report Include="License Detail.rdl" />
    <Report Include="License List.rdl" />
    <Report Include="License Server.rdl" />
    <Report Include="License Summary.rdl" />
    <Report Include="License Windows.rdl" />
    <Report Include="MS 365 License.rdl" />
    <Report Include="MS2016_With_MS365License.rdl" />
    <Report Include="MS365LicenseRenew.rdl" />
    <Report Include="MSOffice2016_AD_WebRoot.rdl" />
    <Report Include="Network Device List.rdl" />
    <Report Include="Network Device Sum.rdl" />
    <Report Include="Queue Device Summary-ERROR.rdl" />
    <Report Include="Queue Device Summary.rdl" />
    <Report Include="Software install type.rdl" />
    <Report Include="Software new install New Software Type By Loc.rdl" />
    <Report Include="Software new install New Software Type.rdl" />
    <Report Include="Software new install.rdl" />
    <Report Include="Software scan by company.rdl" />
    <Report Include="Software scan can not scan computer.rdl" />
    <Report Include="Software scan comname checking.rdl" />
    <Report Include="Software scan Report History.rdl" />
    <Report Include="Software scan Report.rdl" />
    <Report Include="Software scan summary.rdl" />
    <Report Include="Software type.rdl" />
    <Report Include="SWScan Store Insert Data.rdl" />
    <Report Include="SWScan Store Update Data.rdl" />
    <Report Include="Test List Lot.rdl" />
    <Report Include="Test Report.rdl" />
    <Report Include="Webroot.rdl" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Reporting Services\Microsoft.ReportingServices.MSBuilder.targets" />
</Project>