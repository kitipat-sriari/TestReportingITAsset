<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>9a36c807-bea5-4a47-a6ed-c54bf78cc709</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parLoc">
            <Value>=Parameters!parLoc.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parInstallType">
            <Value>=Parameters!parInstallType.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT LocName, ComNameCurrent, InstallType, SumSW
FROM     v_SWScanCurrentHistory_NewInstallSum
WHERE  (LocName IN (@parLoc)) AND (InstallType LIKE @parInstallType)</CommandText>
      </Query>
      <Fields>
        <Field Name="LocName">
          <DataField>LocName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComNameCurrent">
          <DataField>ComNameCurrent</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InstallType">
          <DataField>InstallType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SumSW">
          <DataField>SumSW</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datLocSubMain">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT LocationSub AS SupportMainVal, LocationSub AS SupportMainLab
FROM     v_ConfigLocMainLocSub</CommandText>
      </Query>
      <Fields>
        <Field Name="SupportMainVal">
          <DataField>SupportMainVal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SupportMainLab">
          <DataField>SupportMainLab</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datSWScanMonth">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT SoftwareScanCur + ' And ' + SoftwareScanHistory AS SWScan
FROM     v_SWScanMonth</CommandText>
      </Query>
      <Fields>
        <Field Name="SWScan">
          <DataField>SWScan</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
