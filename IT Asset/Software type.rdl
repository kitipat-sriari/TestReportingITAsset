<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="datITAsset">
      <DataSourceReference>datITAsset</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7d79c2b4-abc1-4425-84f6-fabeba6fdcf1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@parSoftwareName">
            <Value>=Parameters!parSoftwareName.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@parSWtype">
            <Value>=Parameters!parSWtype.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT SoftwareName, SoftwareType, CheckDate, SoftwareType AS SoftwareTyep, Remark, SoftwareTypeID
FROM     v_SWScanType
WHERE  (SoftwareName LIKE CASE WHEN @parSoftwareName = '""' THEN '%' ELSE '%' + @parSoftwareName + '%' END) AND (SoftwareType IN (@parSWtype))
ORDER BY SoftwareName, CheckDate</CommandText>
      </Query>
      <Fields>
        <Field Name="SoftwareName">
          <DataField>SoftwareName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SoftwareType">
          <DataField>SoftwareType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CheckDate">
          <DataField>CheckDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="SoftwareTyep">
          <DataField>SoftwareTyep</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remark">
          <DataField>Remark</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SoftwareTypeID">
          <DataField>SoftwareTypeID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="datSWtype">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT        SoftwareType
FROM            v_SWScanType
GROUP BY SoftwareType
ORDER BY SoftwareType</CommandText>
      </Query>
      <Fields>
        <Field Name="SoftwareType">
          <DataField>SoftwareType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
