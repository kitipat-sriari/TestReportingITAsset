  <DataSets>
    <DataSet Name="datReport">
      <Query>
        <DataSourceName>datITAsset</DataSourceName>
        <CommandText>SELECT SWSSoftware, SWSLoc, SWSComname, WRUserName, COALESCE (ADDislayName, N'') AS ADDislayName, ADLocBeUnder, ADLocWorkAt, ADCalDate, WRLoc, WRLastScan, WRCalDate
FROM     v_MSOffice2016UserName
ORDER BY SWSLoc, SWSComname</CommandText>
      </Query>
